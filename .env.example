# Riffcut environment template.
# Copy to .env (`Copy-Item .env.example .env`) and adjust. Never commit .env.
# Values below match compose.yaml for local development only; use your own
# credentials anywhere else.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string (postgres:// or postgresql://).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://riffcut:riffcut_dev@127.0.0.1:5432/riffcut

# Redis connection string (redis://, or rediss:// for TLS).
# Format: redis://[:<password>@]<host>:<port>[/<db>]
REDIS_URL=redis://127.0.0.1:6379

# --- Optional (defaults shown) ----------------------------------------------

# Interface the API binds to. Use 0.0.0.0 only if you need LAN/container access.
# HOST=127.0.0.1

# Port the API listens on (1-65535).
# PORT=3001

# --- Integration tests only ---------------------------------------------------
# Not read from .env; set them in your shell before `npm run test:integration`.
# Use a separate database: the tests write to it.
# TEST_DATABASE_URL=postgresql://riffcut:riffcut_dev@127.0.0.1:5432/riffcut_test
# TEST_REDIS_URL=redis://127.0.0.1:6379

# --- Private media storage (API and storage:init) -----------------------------
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=riffcut-media
STORAGE_ACCESS_KEY=riffcut_storage
STORAGE_SECRET_KEY=riffcut_dev_storage_only
# Docker CLI must be on PATH, or set its absolute path here.
# DOCKER_BIN=C:\Users\you\AppData\Local\Programs\DockerDesktop\resources\bin\docker.exe
MEDIA_IMAGE=riffcut-media:dev
# Override these Compose host ports if another project uses the defaults.
# Also update DATABASE_URL / STORAGE_ENDPOINT to match.
# POSTGRES_PORT=15432
# STORAGE_PORT=19000
# STORAGE_CONSOLE_PORT=19001
# M1 integration also requires TEST_DATABASE_URL and the storage variables above.
# RUN_MEDIA_INTEGRATION=1

# --- Optional script generation (M2; API and worker use the same settings) -----
# Configure each provider with both its server-side key and a real model ID that
# supports structured JSON output. No model is selected automatically.
# Partial/missing settings disable only that provider's generation requests.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Local alternative: install Ollama and pull this model first. No API key needed.
# OLLAMA_MODEL=qwen3:4b
# RUN_OLLAMA_LIVE_TESTS=1
# Live provider verification is opt-in and makes one paid request per provider.
# RUN_LLM_LIVE_TESTS=1

# Authorized public single-video URL imports; local Whisper model is required.
# Install infra/python/requirements.txt in your Python environment.
# IMPORT_PYTHON=D:/RiffcutModels/runtime/Scripts/python.exe
# WHISPER_MODEL_DIR=D:/RiffcutModels/Whisper/large-v3-turbo
# IMPORT_WORK_DIR=D:/RiffcutModels/imports
# CPU works without CUDA; cuda requires compatible cuBLAS/cuDNN installed.
# WHISPER_DEVICE=cpu

# Queued reviewed renders; explicit local FastThaiG2P v0.3.0 model and Kanit fonts.
# RENDER_PYTHON=D:/RiffcutModels/runtime/Scripts/python.exe
# RENDER_MODEL_DIR=D:/RiffcutModels/TTS/fastthaig2p-v0.3.0
# RENDER_FONTS_DIR=D:/RiffcutModels/Fonts/Kanit
# Bump the profile whenever model, fonts, voice package or renderer settings change.
# RENDER_PROFILE=fastthai-v0.3.0-kanit-v1
# RENDER_WORK_DIR=D:/RiffcutModels/renders
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
